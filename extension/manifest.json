{
  "manifest_version": 3,
  "name": "AIUB Captcha Solver",
  "version": "0.1.2",
  "description": "Fills in the math captcha on the AIUB student portal login page.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "96": "icons/icon-96.png",
    "128": "icons/icon-128.png"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "aiub-captcha-solver@famiu.dev",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    },
    "gecko_android": {
      "strict_min_version": "142.0"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://portal.aiub.edu/*"
      ],
      "js": [
        "model.js",
        "solver.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
